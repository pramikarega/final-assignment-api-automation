        {
          "name": "Create Lab",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data unik per run supaya tidak bentrok dengan data lain",
                  "const stamp = Date.now();",
                  "pm.environment.set(\"lab_title\", \"Newman CRUD Lab \" + stamp);",
                  "pm.environment.set(\"lab_description\", \"Created by Newman CI run \" + stamp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const maxRt = Number(pm.environment.get(\"max_response_time\")) || 5000;",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response body: lab created with correct data\", function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.eql(\"Lab added successfully\");",
                  "    pm.expect(json.data.id).to.be.a(\"number\");",
                  "    pm.expect(json.data.title).to.eql(pm.environment.get(\"lab_title\"));",
                  "    pm.expect(json.data.description).to.eql(pm.environment.get(\"lab_description\"));",
                  "    pm.expect(json.data.user_id).to.eql(pm.environment.get(\"user_id\"));",
                  "});",
                  "",
                  "pm.test(\"Response time is below \" + maxRt + \" ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxRt);",
                  "});",
                  "",
                  "pm.environment.set(\"lab_id\", json.data && json.data.id);"
                ]
              }
            }
          ],
