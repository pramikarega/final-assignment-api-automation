{
  "info": {
    "name": "Script Labs API - Final Assignment",
    "description": "API test suite untuk https://labs.hendri.me (API: https://api-script-labs.hendri.me).\n\nFolder:\n- 01 - Auth: login & simpan token otomatis\n- 02 - Auth Negative: login gagal & akses tanpa/invalid token\n- 03 - Labs CRUD: create, read, update, delete /api/labs\n- 04 - Data-Driven (CSV): jalankan bersama data/labs-data.csv\n\nSemua request /api/labs memakai Bearer {{token}} yang diwariskan dari level collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Auth",
      "description": "Login dan simpan token ke environment.",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fail fast bila kredensial belum di-set (lokal: environment file, CI: GitHub Secrets)",
                  "if (!pm.environment.get(\"email\") || !pm.environment.get(\"password\")) {",
                  "    throw new Error(\"Environment variable 'email' / 'password' kosong. Isi via environment lokal atau --env-var.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const maxRt = Number(pm.environment.get(\"max_response_time\")) || 5000;",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response body: success true & message 'Login successful'\", function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.eql(\"Login successful\");",
                  "});",
                  "",
                  "pm.test(\"Response body: token is a valid JWT string\", function () {",
                  "    pm.expect(json.data.token).to.be.a(\"string\");",
                  "    pm.expect(json.data.token.split(\".\")).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test(\"Response body: user email matches login email\", function () {",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get(\"email\"));",
                  "});",
                  "",
                  "pm.test(\"Response time is below \" + maxRt + \" ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxRt);",
                  "});",
                  "",
                  "// Simpan token & user id secara otomatis -> dipakai request berikutnya",
                  "if (json.data && json.data.token) {",
                  "    pm.environment.set(\"token\", json.data.token);",
                  "    pm.environment.set(\"user_id\", json.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login dengan kredensial dari environment (di CI diisi dari GitHub Secrets). Token disimpan otomatis ke environment variable `token` dan dipakai oleh semua request /api/labs lewat Bearer auth di level collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
