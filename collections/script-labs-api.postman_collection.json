    {
      "name": "04 - Data-Driven (CSV)",
      "description": "Jalankan folder 01 + 04 dengan iteration data data/labs-data.csv.",
      "item": [
        {
          "name": "Create Lab - Data Driven (CSV)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Bangun body dari data CSV (pakai JSON.stringify agar karakter spesial/quote aman)",
                  "function resolve(value) {",
                  "    if (value === undefined || value === null) return \"\";",
                  "    value = String(value);",
                  "    const m = value.match(/^@repeat\\((.),(\\d+)\\)$/);",
                  "    if (m) return m[1].repeat(Number(m[2]));",
                  "    return value;",
                  "}",
                  "",
                  "const body = {};",
                  "[\"title\", \"description\"].forEach(function (field) {",
                  "    const raw = pm.iterationData.get(field);",
                  "    if (raw !== \"@omit\") body[field] = resolve(raw);",
                  "});",
                  "",
                  "pm.variables.set(\"ddt_body\", JSON.stringify(body));",
                  "pm.variables.set(\"ddt_title\", body.title);",
                  "pm.variables.set(\"ddt_description\", body.description);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const maxRt = Number(pm.environment.get(\"max_response_time\")) || 5000;",
                  "const json = pm.response.json();",
                  "",
                  "const scenario = pm.iterationData.get(\"scenario\");",
                  "const type = pm.iterationData.get(\"type\");",
                  "const expectedStatus = Number(pm.iterationData.get(\"expected_status\"));",
                  "const expectedMessage = pm.iterationData.get(\"expected_message\");",
                  "",
                  "pm.test(\"[\" + type + \"] \" + scenario + \" -> status code is \" + expectedStatus, function () {",
                  "    pm.response.to.have.status(expectedStatus);",
                  "});",
                  "",
                  "if (expectedStatus === 201) {",
                  "    pm.test(\"[\" + type + \"] \" + scenario + \" -> response body contains saved data\", function () {",
                  "        pm.expect(json.success).to.eql(true);",
                  "        pm.expect(json.data.id).to.be.a(\"number\");",
                  "        // API melakukan trim pada input",
                  "        pm.expect(json.data.title).to.eql(String(pm.variables.get(\"ddt_title\")).trim());",
                  "        pm.expect(json.data.description).to.eql(String(pm.variables.get(\"ddt_description\")).trim());",
                  "    });",
                  "} else {",
                  "    pm.test(\"[\" + type + \"] \" + scenario + \" -> error message: \" + expectedMessage, function () {",
                  "        pm.expect(json.success).to.eql(false);",
                  "        pm.expect(json.error.message).to.include(expectedMessage);",
                  "    });",
                  "}",
                  "",
                  "pm.test(\"Response time is below \" + maxRt + \" ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxRt);",
                  "});",
                  "",
                  "// Cleanup: hapus data yang berhasil dibuat supaya environment tetap bersih",
                  "if (pm.response.code === 201 && json.data && json.data.id) {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"baseUrl\") + \"/api/labs/\" + json.data.id,",
                  "        method: \"DELETE\",",
                  "        header: { Authorization: \"Bearer \" + pm.environment.get(\"token\") }",
                  "    }, function (err, res) {",
                  "        if (err || res.code !== 200) console.warn(\"Cleanup gagal untuk lab id \" + json.data.id);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/labs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "labs"
              ]
            },
            "description": "Dijalankan dengan file data/labs-data.csv. Kolom: scenario, type, title, description, expected_status, expected_message.\n\nNilai khusus di CSV:\n- `@repeat(X,N)` -> huruf X diulang N kali (untuk uji panjang maksimum)\n- `@omit` -> field tidak dikirim sama sekali\n- sel kosong -> string kosong \"\"",
            "body": {
              "mode": "raw",
              "raw": "{{ddt_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ]
